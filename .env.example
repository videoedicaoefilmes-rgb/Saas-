# ─────────────────────────────────────────────────────────────
# GM Sports Clips — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env com segredos reais.
# ─────────────────────────────────────────────────────────────

# Aplicação
APP_NAME="GM Sports Clips"
APP_URL=http://localhost:3000
# Versão dos Termos de Uso/Política de Privacidade exibida no cadastro.
# Altere quando o texto jurídico for revisado (o aceite fica registrado por usuário).
TERMS_VERSION=rascunho-2026-10

# Banco de dados (PostgreSQL 16+)
DATABASE_URL=postgresql://gmclips:gmclips@localhost:5432/gm_clips

# Autenticação (Better Auth)
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-segredo-aleatorio-com-32-caracteres-ou-mais
BETTER_AUTH_URL=http://localhost:3000

# Fila (Redis 7+)
REDIS_URL=redis://localhost:6379
# Prefixo das chaves da fila (isola ambientes que compartilham o mesmo Redis)
REDIS_PREFIX=gmclips

# ── Armazenamento ────────────────────────────────────────────
# local = disco do servidor (apenas desenvolvimento/testes)
# s3    = qualquer serviço compatível com S3 (AWS S3, Cloudflare R2, MinIO, Backblaze B2...)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/storage
# Segredo para assinar URLs temporárias do driver local. Gere com: openssl rand -base64 32
STORAGE_SIGNING_SECRET=troque-por-outro-segredo-aleatorio-com-32-caracteres

S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Validade das URLs assinadas (segundos)
SIGNED_DOWNLOAD_TTL_SECONDS=300
SIGNED_UPLOAD_TTL_SECONDS=3600

# ── Limites de upload (conservadores para o MVP) ─────────────
# 2 GiB. Para ampliar, veja docs/DEPLOYMENT.md (seção "Arquivos grandes").
UPLOAD_MAX_BYTES=2147483648
# Duração máxima do vídeo enviado (segundos). 3 h.
UPLOAD_MAX_DURATION_SECONDS=10800
UPLOADS_PER_DAY_PER_USER=20

# ── Processamento ───────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Threads por processo FFmpeg e quantos jobs um worker roda em paralelo.
FFMPEG_THREADS=2
WORKER_CONCURRENCY=1
# Tempo máximo de um único processo FFmpeg (segundos) antes de ser encerrado.
FFMPEG_TIMEOUT_SECONDS=900
JOB_MAX_ATTEMPTS=3
# Diretório temporário do worker (vazio = diretório temporário do sistema).
WORKER_TMP_DIR=

# Custo de infraestrutura estimado por minuto de processamento, em centavos de BRL.
# Deixe vazio até medir o custo real (ver docs/ARCHITECTURE.md, "Custos").
INFRA_COST_CENTS_PER_PROCESSING_MINUTE=

# ── Créditos (valores iniciais; podem ser alterados no painel admin) ──
BILLING_UNIT_SECONDS=60
CREDITS_PER_UNIT=1
BILLING_MIN_CREDITS=1
SIGNUP_BONUS_CREDITS=0
# Botão "Adicionar créditos de teste" (desenvolvimento/homologação). Desligue em produção.
ENABLE_TEST_CREDITS=true
TEST_CREDITS_AMOUNT=60

# ── Retenção de arquivos (dias) ──────────────────────────────
RETENTION_SOURCE_DAYS=30
RETENTION_EXPORT_DAYS=30

# ── E-mail ──────────────────────────────────────────────────
# console = imprime o e-mail no log do servidor (somente desenvolvimento)
# smtp    = envia via SMTP (qualquer provedor)
MAIL_DRIVER=console
MAIL_FROM="GM Sports Clips <nao-responda@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Nível de log: debug | info | warn | error
LOG_LEVEL=info

# Desativa a telemetria anônima do Next.js
NEXT_TELEMETRY_DISABLED=1
